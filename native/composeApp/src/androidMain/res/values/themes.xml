<resources>
    <!-- Compose draws everything; the window theme only sets what shows
         before the first frame. Edge to edge: bars are transparent. -->
    <style name="Theme.Virulenter" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
