<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode: light status and navigation bar icons on the dark bars. -->
    <style name="Theme.Virulenter" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
